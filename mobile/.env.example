# Vechelon Rail 3 — Expo public env vars.
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time.
#
# Rail 3 points at the rail3-staging project (NOT production) — see
# docs/rail3-staging.md. Copy this to .env and fill in values; never commit .env.
EXPO_PUBLIC_SUPABASE_URL=https://xybgtbybdhxuwqjfcfkc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key-here

# The club this build serves. Resolved at runtime from config — never hardcode a
# tenant slug/UUID in logic. Passed to send-magic-link for per-club email branding.
EXPO_PUBLIC_TENANT_SLUG=racer-sportif
