VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_JOIN_BASE_URL=https://your-rider-domain.com

# W190 — Rail 3 web fleet view ("Race Control"). Leave UNSET in production:
# prod Supabase lacks the W170 rail3:ride channel-authorization policy, so the
# /race-control/:rideId route stays unregistered until Rail 3 promotion. Set to
# "true" locally with VITE_SUPABASE_* pointed at rail3-staging to run the PoC.
VITE_RAIL3_FLEET_ENABLED=false

# W192 — Rail 3 staging fleet-view deployment only. Pins the tenant this build
# serves regardless of host, so a non-*.vechelon.ca staging URL (e.g. a Vercel
# preview) resolves the club instead of ClubNotFound. MUST stay UNSET in the
# production project — prod resolves the tenant from its *.vechelon.ca subdomain.
VITE_TENANT_SLUG_OVERRIDE=
